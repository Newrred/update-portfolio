---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="페이지를 찾을 수 없습니다." description="잘못된 주소이거나 아직 공개되지 않은 기록입니다.">
  <section class="page-section">
    <div class="container">
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p class="lead">주소가 바뀌었거나 아직 공개되지 않은 기록일 수 있습니다.</p>
      <p><a href={withBase('/archive/')}>아카이브로 이동</a></p>
    </div>
  </section>
</BaseLayout>
