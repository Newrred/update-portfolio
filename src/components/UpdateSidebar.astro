---
import { AREA_META, KIND_META } from '../data/site';
import { formatLongDate, getEntryUrl, type UpdateEntry } from '../utils/updates';

interface Props {
  entry: UpdateEntry;
  related?: UpdateEntry[];
}

const { entry, related = [] } = Astro.props;

const rows = [
  { term: '빌드', value: entry.data.build },
  { term: '날짜', value: formatLongDate(entry.data.date) },
  { term: '유형', value: KIND_META[entry.data.kind] },
  {
    term: '분야',
    value: entry.data.areas.map((area) => AREA_META[area].label).join(', '),
  },
  entry.data.credit ? { term: '문맥', value: entry.data.credit } : null,
  entry.data.role ? { term: '역할', value: entry.data.role } : null,
  entry.data.stack.length > 0 ? { term: '도구', value: entry.data.stack.join(', ') } : null,
  entry.data.assist.length > 0
    ? { term: 'AI 보조', value: entry.data.assist.join(', ') }
    : null,
].filter(Boolean) as { term: string; value: string }[];
---

<aside class="sidebar-stack article-rail">
  <section>
    <h2>정보</h2>

    <dl class="meta-table">
      {
        rows.map((row) => (
          <div>
            <dt>{row.term}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    entry.data.links.length > 0 && (
      <section>
        <h2>링크</h2>
        <ul class="link-list">
          {
            entry.data.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section>
        <h2>같이 보기</h2>

        <ul class="entry-list entry-list--compact">
          {
            related.map((item) => (
              <li>
                <a class="entry-list__title" href={getEntryUrl(item)}>
                  {item.data.title}
                </a>
                <p>{item.data.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }
</aside>
