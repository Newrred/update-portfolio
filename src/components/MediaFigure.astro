---
import { withBase } from '../utils/paths';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const resolvedSrc = withBase(src);
---

<figure class="media-figure">
  <img src={resolvedSrc} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
