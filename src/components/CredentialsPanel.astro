---
import { siteConfig } from '../data/site';
---

<section class="credentials">
  <details open>
    <summary>작업 범위와 공개 원칙</summary>

    <div class="credentials-stack">
      <dl class="credentials-sheet">
        {
          siteConfig.facts.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        siteConfig.credentials.map((group) => (
          <section class="credential-group">
            <h2>{group.title}</h2>
            <ul class="credential-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </details>
</section>
