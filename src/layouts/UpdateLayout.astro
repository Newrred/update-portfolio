---
import UpdateSidebar from '../components/UpdateSidebar.astro';
import { AREA_META, KIND_META } from '../data/site';
import type { UpdateEntry } from '../utils/updates';
import { formatLongDate, getEntryCover } from '../utils/updates';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: UpdateEntry;
  related?: UpdateEntry[];
}

const { entry, related = [] } = Astro.props;
const areaLine = entry.data.areas.map((area) => AREA_META[area].label).join(' / ');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  currentPath="/archive/"
>
  <section class="page-section">
    <div class="container container--wide article-shell">
      <div class="article-shell__topline">
        <a class="back-link" href="/archive/">아카이브로 돌아가기</a>
        <p class="mono-text">
          {KIND_META[entry.data.kind]} / {areaLine}
        </p>
      </div>

      <article class="article article--editorial">
        <header class="article-head article-head--editorial">
          <div class="article-head__copy">
            <p class="article-kicker mono-text">
              {entry.data.build} · {formatLongDate(entry.data.date)}
            </p>
            <h1>{entry.data.title}</h1>
            <p class="article-summary">{entry.data.summary}</p>
          </div>

          <figure class="article-cover article-cover--editorial">
            <img src={getEntryCover(entry)} alt={entry.data.title} loading="eager" />
          </figure>
        </header>

        <div class="article-body-grid">
          <div class="prose prose--editorial">
            <slot />
          </div>

          <UpdateSidebar entry={entry} related={related} />
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
